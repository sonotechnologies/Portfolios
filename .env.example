# Copy to .env.local for development, or set these in your deploy platform
# (e.g. Vercel project settings). Neither has a real value in this repo —
# the contact form fails closed with an honest error message if
# RESEND_API_KEY is missing, it never silently drops a message.

# Resend API key (https://resend.com/api-keys). Required for the contact
# form's server action to actually send mail.
#
# The action sends from onboarding@resend.dev (Resend's shared sandbox
# domain) until a real domain exists — Resend only lets that address send
# to the account's own verified email, so it works for delivering to
# sonotechnologies@gmail.com but nowhere else. Once the domain is
# registered and verified with Resend, update the `from` address in
# src/lib/actions/contact.ts to send from it instead.
RESEND_API_KEY=

# Where enquiries land. Defaults to sonotechnologies@gmail.com
# (src/content/site-config.ts) if unset.
CONTACT_TO_EMAIL=sonotechnologies@gmail.com
